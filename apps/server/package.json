{
  "name": "@wrapt/server",
  "version": "2.19.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRAPT_DEV_WATCH=1 tsx watch src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/compress": "9.2.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/reply-from": "12.7.1",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@wrapt/contracts": "workspace:*",
    "@wrapt/extension-contracts": "workspace:*",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "dotenv": "18.0.8",
    "execa": "10.2.0",
    "fastify": "5.12.7",
    "node-pty": "^1.1.0",
    "parse5": "8.0.1",
    "systeminformation": "5.33.16",
    "undici": "8.12.3",
    "web-push": "^3.6.7",
    "ws": "8.22.0",
    "zod": "4.6.7",
    "@wrapt/plugin-sdk": "workspace:*",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "vitest": "5.0.1"
  }
}
