  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
