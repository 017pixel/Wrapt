# -----------------------------------------------------------------------------
# .env — nur Secrets und neutrale Runtime-Einstellungen.
# Persönliche Werte (Name, Tailscale-Host, E-Mails, Pfade, CLI-Pfade, CodexBar)
# gehören NICHT hierher, sondern nach config/wrapt.local.json
# (Vorlage: config/wrapt.example.json). Env-Variablen hier überschreiben
# bei Bedarf einzelne Werte aus dieser Config.
# -----------------------------------------------------------------------------

# Wrapt HTTP server. Keep HOST on localhost in production.
HOST=127.0.0.1
PORT=3010
LOG_LEVEL=info
# Die Produktversion kommt aus package.json und wird hier nicht mehr gesetzt.

# Optional alternate backend for the Vite development proxy.
WRAPT_DEV_BACKEND_URL=http://127.0.0.1:3010
# Nur für einen isolierten lokalen E2E-Proxy setzen, niemals in Produktion:
# WRAPT_DEV_TAILSCALE_USER=user@example.com

# Absolute paths may be used in systemd; relative paths resolve from the repo root.
CONFIG_DIR=./config
WEB_DIST_DIR=./apps/web/dist

# Project discovery. Roots live in config/wrapt.local.json (paths.projectsRoot).
PROJECT_DISCOVERY_ENABLED=true
PROJECT_ACTIVITY_CACHE_MS=300000
PROJECT_ACTIVITY_MAX_DEPTH=8
PROJECT_ACTIVITY_MAX_FILES=20000
PROJECT_ACTIVITY_CONCURRENCY=4
PROJECT_LIST_CACHE_MS=5000
ORBIT_RECENT_PROJECT_LIMIT=8
ORBIT_PROJECT_BROWSER_PAGE_SIZE=300

# Read-only polling/cache configuration in milliseconds.
METRICS_CACHE_MS=5000
SUMMARY_CACHE_MS=30000
SERVICE_CACHE_MS=10000
LOCAL_PORT_CACHE_MS=5000
AUDIT_VERIFY_CACHE_MS=5000
LOCAL_PORT_PROBE_TIMEOUT_MS=450
REQUEST_TIMEOUT_MS=3000
COMPRESSION_THRESHOLD_BYTES=1024
BROTLI_QUALITY=4

# Protect only /api/**. Editor/Vite proxy traffic is intentionally excluded.
# Counted per IP and per minute. Behind the Tailscale proxy every request looks like
# 127.0.0.1, so this is effectively one shared budget for all open tabs — and the UI
# alone polls 20-45 requests per minute per tab (terminal sessions every 3s, metrics,
# services and ports every 10s). /api/v1/health is exempt.
API_RATE_LIMIT_MAX=1200
# code-server emits WebSocket frames larger than 64 KiB during startup.
WEBSOCKET_MAX_PAYLOAD_BYTES=16777216

# Local CodexBar service used for project-grouped cost history.
# The CLI path and config path live in config/wrapt.local.json (cli.codexbar, codexbar.configPath).
CODEXBAR_BASE_URL=http://127.0.0.1:18181
CODEXBAR_CACHE_MS=60000
CODEXBAR_TIMEOUT_MS=35000

# Opt-in fallback when CodexBar omits an active 5-hour Codex window.
# Profile homes live in config/wrapt.local.json (codexbar.oauthProfileHomes).
CODEX_OAUTH_PRIMARY_FALLBACK=false
CODEX_OAUTH_TIMEOUT_MS=5000

# Reverse proxy timeout for embedded services (code-server, previews, T3 Code).
PROXY_TIMEOUT_MS=15000
PROXY_MAX_HTML_BYTES=4194304

# Preview Hub. Der vertrauenswürdige npm-Pfad liegt unter previews.npmExecutable
# in config/wrapt.local.json; der ausgeführte Befehl bleibt immer `npm run dev`.
PREVIEW_DEV_SERVER_LOG_BYTES=131072
PREVIEW_DEV_SERVER_START_TIMEOUT_MS=15000

# Browser terminal session limits. Allowed users/roots live in config/wrapt.local.json.
TERMINAL_MAX_SESSIONS=24
TERMINAL_SUPERVISOR=tmux

# Interactive agent CLI session limits. Executable paths live in config/wrapt.local.json (cli.*).
CODEX_MAX_SESSIONS=12
OPENCODE_MAX_SESSIONS=12
CLAUDE_MAX_SESSIONS=4

# Persistent local usage history. The database path lives in config/wrapt.local.json.
USAGE_SNAPSHOT_INTERVAL_MS=300000

# Server-persisted Orbit document. Backup/asset dirs live in config/wrapt.local.json.
ORBIT_SYNC_INTERVAL_MS=5000
ORBIT_DOCUMENT_MAX_BYTES=4194304
ORBIT_ASSET_MAX_FILE_BYTES=104857600
ORBIT_ASSET_MAX_TOTAL_BYTES=53687091200
ORBIT_DESTRUCTIVE_DROP_PERCENT=50
ORBIT_REVISION_RETENTION_COUNT=500
ORBIT_CONFLICT_RETENTION_COUNT=100

# File gallery (Dateigalerie). Upload dir lives in config/wrapt.local.json (fileGalleryDir).
FILE_GALLERY_MAX_FILE_BYTES=104857600
FILE_GALLERY_MAX_TOTAL_BYTES=53687091200

# T3 Code (single instance behind the /t3 proxy). Der Kanal (stable|nightly) lebt in
# config/wrapt.local.json unter "t3.channel" — er wird von Einstellungen → T3 Code Kanal
# geschrieben. Auch CLI-Pfad und Ports stehen dort (t3.*); die Zeilen unten nur aktivieren,
# wenn sie gezielt von der Config abweichen sollen.
# T3_CLI_PATH=/home/your-user/.npm-global/bin/t3
# T3_NPM_PACKAGE=t3
# T3_HOST=127.0.0.1
# T3_PORT=3773
# T3_SERVICE_UNIT=t3-code.service

# Hermes Agent. Alle Werte stehen in config/wrapt.local.json unter "hermes" —
# install-hermes.sh trägt die erkannten Pfade dort ein. Die Zeilen unten nur
# aktivieren, um die Config gezielt zu überschreiben.
# HERMES_ENABLED=true
# HERMES_HOST=127.0.0.1
# HERMES_PORT=9119
# HERMES_CLI_PATH=/home/your-user/.local/bin/hermes
# HERMES_HOME=/home/your-user/.hermes
# HERMES_CHECKOUT_DIRECTORY=/home/your-user/.hermes/hermes-agent
# HERMES_PYTHON_PATH=/home/your-user/.hermes/hermes-agent/venv/bin/python
# HERMES_PROXY_PREFIX=/hermes
# HERMES_DASHBOARD_UNIT=hermes-dashboard.service
# HERMES_GATEWAY_UNIT=hermes-gateway.service
# HERMES_UPDATE_UNIT=hermes-update.service
